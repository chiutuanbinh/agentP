# Required
ANTHROPIC_API_KEY=
JIRA_URL=https://yourco.atlassian.net
JIRA_USER=you@yourco.com
JIRA_API_TOKEN=
GITHUB_TOKEN=

# Optional — Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional — Confluence (falls back to Jira creds if unset)
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=

# Optional — Slack notifications
SLACK_WEBHOOK_URL=

# Optional — repo checkout root (defaults to ~/workspace)
WORKSPACE=
